<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- Tree View                                      -->
    <!-- ============================================== -->
    <record id="view_corr_incoming_tree" model="ir.ui.view">
        <field name="name">corr.incoming.tree</field>
        <field name="model">corr.incoming</field>
        <field name="arch" type="xml">
            <list delete="false">
                <field name="name"/>
                <field name="subject"/>
                <!-- <field name="partner_id"/> -->
                <field name="doc_arrival_date"/>
                <field name="create_uid" string="Инициатор"/>
                <field name="assignment_count" string="Заданий"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state in ('review', 'revision')"
                       decoration-primary="state in ('execution', 'rework')"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'canceled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- Kanban View                                    -->
    <!-- ============================================== -->
    <record id="view_corr_incoming_kanban" model="ir.ui.view">
        <field name="name">corr.incoming.kanban</field>
        <field name="model">corr.incoming</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="subject"/>
                <!-- <field name="partner_id"/> -->
                <field name="doc_arrival_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="state" widget="badge" 
                                           decoration-info="state == 'draft'" 
                                           decoration-warning="state in ('review', 'revision')"
                                           decoration-primary="state in ('execution', 'rework')"
                                           decoration-success="state == 'done'"
                                           decoration-danger="state == 'canceled'"/>
                                </div>
                                <div>Тема: <field name="subject"/></div>
                                <!-- <div>Отправитель: <field name="partner_id"/></div> -->
                                <div>Дата: <field name="doc_arrival_date"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- Form View                                      -->
    <!-- ============================================== -->
    <record id="view_corr_incoming_form" model="ir.ui.view">
        <field name="name">corr.incoming.form</field>
        <field name="model">corr.incoming</field>
        <field name="arch" type="xml">
            <form string="Входящая корреспонденция">

                <header>
                    <button name="action_create_outgoing"
                            string="Создать исходящее"
                            type="object"
                            class="btn-secondary"
                            icon="fa-envelope"
                            invisible="state == 'draft'"/>
                    <!-- ========================================= -->
                    <!-- Кнопка: На согласование (draft/revision)  -->
                    <!-- ========================================= -->
                    <button name="action_send_to_approval"
                            string="На согласование"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft', 'revision']"
                            groups="correspondence.group_correspondence_secretary,correspondence.group_correspondence_director,correspondence.group_correspondence_admin"/>

                    <!-- ========================================= -->
                    <!-- Кнопки appstream_approval (согласование)  -->
                    <!-- ========================================= -->
                    
                    <!-- Согласовать -->
                    <button name="action_approve"
                            string="Согласовать"
                            type="object"
                            class="btn-primary"
                            invisible="not button_approve_enabled or state in ['draft', 'revision', 'execution', 'rework', 'done', 'canceled']"
                            confirm="Подтвердить согласование?"/>

                    <!-- Вернуть на доработку (review → revision) -->
                    <button name="action_return"
                            string="Вернуть на доработку"
                            type="object"
                            class="btn-warning"
                            invisible="not button_return_enabled or state != 'review'"
                            context="{'fixed_return_state': 'revision'}"
                            groups="correspondence.group_correspondence_director,correspondence.group_correspondence_admin"/>

                    <!-- Закрыть (review → done) когда нет заданий -->
                    <button name="action_close_document"
                            string="Закрыть"
                            type="object"
                            class="btn-success"
                            invisible="state != 'review'"
                            confirm="Закрыть документ без создания заданий?"
                            groups="correspondence.group_correspondence_director,correspondence.group_correspondence_admin"/>

                    <!-- ========================================= -->
                    <!-- Кнопка: На доработку задач (done)         -->
                    <!-- ========================================= -->
                    <button name="action_open_rework_wizard"
                            string="На доработку задач"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'done'"
                            groups="correspondence.group_correspondence_director,correspondence.group_correspondence_secretary,correspondence.group_correspondence_admin"/>

                    <!-- ========================================= -->
                    <!-- Statusbar                                 -->
                    <!-- ========================================= -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,execution,done"/>
                </header>

                <sheet>
                    <!-- Smart buttons (правый верхний угол формы) -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_outgoing"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-envelope"
                                invisible="state == 'draft'">
                            <field name="outgoing_count"
                                   widget="statinfo"
                                   string="Исходящие"/>
                        </button>
                    </div>
                    <!-- ========================================= -->
                    <!-- Информационные баннеры                    -->
                    <!-- ========================================= -->
                    
                    <!-- Баннер: Ожидание согласования -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'review' or button_approve_enabled">
                        <strong>Ожидание согласования.</strong> Документ находится на согласовании у других пользователей.
                    </div>

                    <!-- Баннер: Ваша очередь согласовать -->
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'review' or not button_approve_enabled">
                        <strong>Требуется ваше согласование!</strong> Нажмите кнопку "Согласовать" для продолжения.
                    </div>

                    <!-- Баннер: Исполнение -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'execution'">
                        <strong>Исполнение.</strong> Документ завершится автоматически, когда все задания будут выполнены.
                    </div>

                    <!-- Баннер: Доработка задач -->
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'rework'">
                        <strong>Доработка задач.</strong> После выполнения всех заданий документ завершится.
                    </div>

                    <!-- Баннер: Доработка заявки -->
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'revision'">>
                        <strong>Доработка заявки.</strong> Внесите исправления и отправьте повторно на согласование.
                    </div>

                    <!-- ========================================= -->
                    <!-- Основная информация                       -->
                    <!-- ========================================= -->
                    <group>
                        <group string="Документ">
                            <field name="name" readonly="1"/>
                            <field name="subject" readonly="state not in ['draft', 'revision']"/>
                            <!-- <field name="partner_id" attrs="{'readonly': [('state', 'not in', ['draft', 'revision'])]}"/> -->
                            <field name="doc_arrival_date" readonly="state not in ['draft', 'revision']"/>
                            <field name="language" readonly="state not in ['draft', 'revision']"/>
                            <field name="external_number" readonly="state not in ['draft', 'revision']"/>
                            <field name="shipment_method_ids" widget="many2many_tags" options="{'no_create': True}" string="Метод получения" readonly="state not in ['draft', 'revision']"/>
                        </group>
                        <group string="Информация">
                            <field name="create_uid" string="Инициатор" readonly="1"/>
                            <field name="create_date" string="Дата создания" readonly="1"/>
                            <field name="assignment_count" string="Заданий"/>
                        </group>
                    </group>

                    <group string="Содержание" >
                        <field name="summary" nolabel="1" colspan="2"
                               readonly="state not in ['draft', 'revision']"/>
                    </group>

                    <!-- Скрытые поля для условий видимости -->
                    <field name="button_approve_enabled" invisible="1"/>
                    <field name="button_return_enabled" invisible="1"/>
                    <field name="user_can_approve" invisible="1"/>

                    <!-- ========================================= -->
                    <!-- Вложения                                  -->
                    <!-- ========================================= -->
                    <group string="Вложения">
                            <group>
                                <field name="attachment_mail_ids"
                                    widget="many2many_binary"
                                    string="Входящее письмо"
                                    readonly="state not in ['draft', 'revision']"/>
                            </group>
                            <group>
                                <field name="attachment_rest_ids"
                                    widget="many2many_binary"
                                    string="Документы от отправителя"
                                    readonly="state not in ['draft', 'revision']"/>
                            </group>
                    </group>
                    <!-- ========================================= -->
                    <!-- Notebook: Задания и Согласование          -->
                    <!-- ========================================= -->
                    <notebook>
                        <!-- Вкладка: Задания -->
                        <page string="Задания" name="assignments">
                            <field name="assignment_line_ids"
                                   readonly="state == 'done'">
                                <list editable="bottom"
                                      decoration-danger="is_overdue"
                                      decoration-success="status == 'done'"
                                      decoration-muted="status == 'done'">
                                    <field name="id" column_invisible="1"/>
                                    <field name="is_overdue" column_invisible="1"/>
                                    <field name="user_id" readonly="id != False"/>
                                    <field name="delegated" column_invisible="1"/>
                                    <field name="resolution_id" readonly="id != False"/>
                                    <field name="task" readonly="id != False"/>
                                    <field name="deadline" readonly="id != False"/>
                                    <field name="report_needed" readonly="id != False"/>
                                    <field name="status"/>
                                    <field name="completion_datetime" readonly="1"/>
                                    <field name="report"/>
                                    <field name="attachment_ids" widget="many2many_binary" string="Вложения"/>
                                    <field name="assigner_id" readonly="1"/>
                                    <field name="original_user_id" invisible="not delegated"/>
                                </list>
                            </field>
                        </page>
                        <!-- Вкладка: Текущие согласующие -->
                        <page string="Согласующие" name="approvers"
                              invisible="state not in ['review']">>
                            <field name="state_agreement_line_ids" readonly="1">
                                <list decoration-success="status == 'agreed'"
                                      decoration-warning="status == 'in_progress'"
                                      decoration-muted="status == 'waiting'">
                                    <field name="sequence" string="№"/>
                                    <field name="user_id"/>
                                    <field name="job_id"/>
                                    <field name="status"/>
                                    <field name="agreement_date"/>
                                    <field name="commentary"/>
                                </list>
                            </field>
                        </page>
                        <!-- Вкладка: История согласований -->
                        <page string="История согласований" name="approval_history">
                            <field name="state_agreement_history_line_ids" readonly="1">
                                <list>
                                    <field name="user_id"/>
                                    <field name="job_id"/>
                                    <field name="status"/>
                                    <field name="agreement_date"/>
                                    <field name="commentary"/>
                                    <field name="signed" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <!-- ========================================= -->
                <!-- Chatter                                   -->
                <!-- ========================================= -->
                <chatter/>

            </form>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- Search View                                    -->
    <!-- ============================================== -->
    <record id="view_corr_incoming_search" model="ir.ui.view">
        <field name="name">corr.incoming.search</field>
        <field name="model">corr.incoming</field>
        <field name="arch" type="xml">
            <search string="Входящая корреспонденция">
                <field name="name"/>
                <field name="subject"/>
                <!-- <field name="partner_id"/> -->
                <field name="create_uid" string="Инициатор"/>
                <separator/>
                <filter string="Мои документы" name="my_documents" 
                        domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter string="Черновик" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Доработка" name="state_revision" domain="[('state', '=', 'revision')]"/>
                <filter string="Ознакомление" name="state_review" domain="[('state', '=', 'review')]"/>
                <filter string="Исполнение" name="state_execution" domain="[('state', '=', 'execution')]"/>
                <filter string="Доработка задач" name="state_rework" domain="[('state', '=', 'rework')]"/>
                <filter string="Завершено" name="state_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Статус" name="group_state" context="{'group_by': 'state'}"/>
                <!-- <filter string="Отправитель" name="group_partner" context="{'group_by': 'partner_id'}"/> -->
                <filter string="Инициатор" name="group_initiator" context="{'group_by': 'create_uid'}"/>
                <filter string="Дата документа" name="group_date" context="{'group_by': 'doc_arrival_date'}"/>
                <separator/>
                <filter name="activities_my" string="С моими активити"
                        domain="[('activity_user_id', '=', uid)]"/>
                <filter name="activities_overdue" string="Просроченные активити"
                        domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="activities_today" string="Активити на сегодня"
                        domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="activities_upcoming_all" string="Будущие активити"
                        domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

</odoo>