<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree -->
    <record id="view_outgoing_recipients_tree" model="ir.ui.view">
        <field name="name">correspondence.outgoing.recipients.tree</field>
        <field name="model">correspondence.outgoing.recipients</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="recipient"/>
                <field name="shipment_method_ids" widget="many2many_tags"/>
                <field name="full_name" optional="show"/>
                <field name="position" optional="show"/>
                <field name="address" optional="hide"/>
                <field name="email" optional="show"/>
                <field name="odoo_user_id" optional="hide"/>
                <field name="phone" optional="hide"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_outgoing_recipients_form" model="ir.ui.view">
        <field name="name">correspondence.outgoing.recipients.form</field>
        <field name="model">correspondence.outgoing.recipients</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Основное">
                            <field name="recipient"/>
                            <field name="shipment_method_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                        <group string="Контактная информация">
                            <field name="full_name"/>
                            <field name="position"/>
                            <field name="address"/>
                            <field name="email"/>
                            <field name="odoo_user_id"/>
                            <field name="phone"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_outgoing_recipients" model="ir.actions.act_window">
        <field name="name">Получатели</field>
        <field name="res_model">correspondence.outgoing.recipients</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
