<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree -->
    <record id="view_outgoing_type_tree" model="ir.ui.view">
        <field name="name">correspondence.outgoing.type.tree</field>
        <field name="model">correspondence.outgoing.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="esp_signer_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_outgoing_type_form" model="ir.ui.view">
        <field name="name">correspondence.outgoing.type.form</field>
        <field name="model">correspondence.outgoing.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="esp_signer_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_outgoing_type" model="ir.actions.act_window">
        <field name="name">Типы писем</field>
        <field name="res_model">correspondence.outgoing.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
