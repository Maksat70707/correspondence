<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Поручения по входящим. Модель, вьюхи и мастер — модуль assignment,
         здесь — действия меню корреспонденции и форма мастера доработки.

         Действия показывают поручения по входящим и поручения без
         документа (заведённые прямо в списке), но не поручения других
         модулей: у документооборота свои. -->

    <!-- Поручения сотрудника: свои, назначенные им и прежние -->
    <record id="action_assignment_tasks_employee" model="ir.actions.act_window">
        <field name="name">Поручения</field>
        <field name="res_model">assignment.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="assignment.assignment_line_view_search"/>
        <field name="domain">[('document_model', 'in', [False, 'corr.incoming']), '|', '|', ('user_id', '=', uid), ('assigner_id', '=', uid), ('executor_history_ids', 'in', uid)]</field>
        <field name="context">{'search_default_filter_assigned_to_me': 1, 'search_default_group_status': 1}</field>
    </record>

    <record id="action_assignment_tasks_employee_tree" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="assignment.assignment_line_view_list"/>
        <field name="act_window_id" ref="action_assignment_tasks_employee"/>
    </record>

    <record id="action_assignment_tasks_employee_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="assignment.assignment_line_view_form"/>
        <field name="act_window_id" ref="action_assignment_tasks_employee"/>
    </record>

    <!-- Поручения для директора и администратора — все по входящим -->
    <record id="action_assignment_tasks_all" model="ir.actions.act_window">
        <field name="name">Поручения</field>
        <field name="res_model">assignment.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="assignment.assignment_line_view_search"/>
        <field name="domain">[('document_model', 'in', [False, 'corr.incoming'])]</field>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>

    <record id="action_assignment_tasks_all_tree" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="assignment.assignment_line_view_list"/>
        <field name="act_window_id" ref="action_assignment_tasks_all"/>
    </record>

    <record id="action_assignment_tasks_all_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="assignment.assignment_line_view_form"/>
        <field name="act_window_id" ref="action_assignment_tasks_all"/>
    </record>

    <!-- Отчётность по задачам -->
    <record id="action_assignment_line_report" model="ir.actions.act_window">
        <field name="name">Отчётность по задачам</field>
        <field name="res_model">assignment.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="assignment.assignment_line_view_search"/>
        <field name="domain">[('document_model', 'in', [False, 'corr.incoming'])]</field>
        <field name="context">{'create': 0, 'search_default_group_status': 1}</field>
    </record>

    <record id="action_assignment_line_report_tree" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="assignment.assignment_line_view_list_report"/>
        <field name="act_window_id" ref="action_assignment_line_report"/>
    </record>

    <!-- Отправка на доработку задач: общий мастер «Поручить» со своей
         подписью к комментарию и кнопкой. Причина обязательна. -->
    <record id="view_correspondence_rework_wizard_form" model="ir.ui.view">
        <field name="name">assignment.wizard.form.correspondence.rework</field>
        <field name="model">assignment.wizard</field>
        <field name="inherit_id" ref="assignment.assignment_wizard_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="note" position="attributes">
                <attribute name="string">Причина доработки</attribute>
                <attribute name="placeholder">Что нужно доработать</attribute>
            </field>
            <button name="action_confirm" position="attributes">
                <attribute name="string">Отправить на доработку</attribute>
            </button>
        </field>
    </record>

</odoo>
