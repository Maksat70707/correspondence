<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree -->
    <record id="view_shipment_method_tree" model="ir.ui.view">
        <field name="name">correspondence.shipment.method.tree</field>
        <field name="model">correspondence.shipment.method</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_shipment_method_form" model="ir.ui.view">
        <field name="name">correspondence.shipment.method.form</field>
        <field name="model">correspondence.shipment.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipment_method" model="ir.actions.act_window">
        <field name="name">Методы отправки</field>
        <field name="res_model">correspondence.shipment.method</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
