<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- Tree View                                      -->
    <!-- ============================================== -->
    <record id="view_corr_outgoing_tree" model="ir.ui.view">
        <field name="name">corr.outgoing.tree</field>
        <field name="model">corr.outgoing</field>
        <field name="arch" type="xml">
            <list create="true" delete="false">
                <field name="name"/>
                <field name="subject"/>
                <field name="create_uid" string="Инициатор"/>
                <field name="create_date" string="Дата создания"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state in ('under_approval', 'approval', 'approval_medical_examination', 'processing')"
                       decoration-primary="state == 'review'"
                       decoration-success="state == 'done'"
                       decoration-danger="state in ('rejected', 'canceled')"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- Kanban View                                    -->
    <!-- ============================================== -->
    <record id="view_corr_outgoing_kanban" model="ir.ui.view">
        <field name="name">corr.outgoing.kanban</field>
        <field name="model">corr.outgoing</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="subject"/>
                <field name="create_uid"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="state" widget="badge" 
                                           decoration-info="state == 'draft'" 
                                           decoration-warning="state in ('under_approval', 'approval', 'approval_medical_examination', 'processing')"
                                           decoration-primary="state == 'review'"
                                           decoration-success="state == 'done'"
                                           decoration-danger="state in ('rejected', 'canceled')"/>
                                </div>
                                <div>Тема: <field name="subject"/></div>
                                <div>Инициатор: <field name="create_uid"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- Form View                                      -->
    <!-- ============================================== -->
    <record id="view_corr_outgoing_form" model="ir.ui.view">
        <field name="name">corr.outgoing.form</field>
        <field name="model">corr.outgoing</field>
        <field name="arch" type="xml">
            <form string="Исходящая корреспонденция">

                <header>
                    <!-- ========================================= -->
                    <!-- Кнопка: На согласование (draft)           -->
                    <!-- ========================================= -->
                    <button name="action_send_to_approval"
                            string="На согласование"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="correspondence.group_correspondence_employee,correspondence.group_correspondence_secretary,correspondence.group_correspondence_director,correspondence.group_correspondence_admin"/>

                    <!-- ========================================= -->
                    <!-- Кнопки согласования                       -->
                    <!-- ========================================= -->
                    
                    <!-- Согласовать (under_approval, без ЭЦП) -->
                    <button name="action_approve"
                            string="Согласовать"
                            type="object"
                            class="btn-primary"
                            invisible="not button_approve_enabled or state != 'under_approval' or user_esp"
                            confirm="Подтвердить согласование?"/>

                    <!-- Утвердить с ЭЦП (approval) - виджет для NCALayer -->
                    <widget name="ncalayer_sign_button"
                            string="Утвердить с ЭЦП"
                            highlight="True"
                            invisible="not button_approve_enabled or state != 'approval' or not user_esp"/>

                    <!-- Подписать с ЭЦП (approval_medical_examination) - виджет для NCALayer -->
                    <widget name="ncalayer_sign_button"
                            string="Подписать с ЭЦП"
                            highlight="True"
                            invisible="not button_approve_enabled or state != 'approval_medical_examination' or not user_esp"/>

                    <!-- Отказаться от мед. освидетельствования (только для employee_id) -->
                    <button name="action_refuse_medical_examination"
                            string="Отказаться от мед. освидетельствования"
                            type="object"
                            class="btn-warning"
                            invisible="not is_employee_signer"
                            confirm="Вы уверены, что хотите отказаться от прохождения медицинского освидетельствования?"/>

                    <!-- Обработано (processing) -->
                    <button name="action_approve"
                            string="Обработано"
                            type="object"
                            class="btn-primary"
                            invisible="not button_approve_enabled or state != 'processing'"
                            confirm="Подтвердить обработку?"/>

                    <!-- Ознакомлен (review, только инициатор) -->
                    <button name="action_acknowledge"
                            string="Ознакомлен"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'review' or not is_initiator"
                            confirm="Подтвердить ознакомление?"/>

                    <!-- ========================================= -->
                    <!-- Кнопки возврата и отклонения              -->
                    <!-- ========================================= -->

                    <!-- Вернуть на доработку (under_approval, approval, approval_medical_examination) -->
                    <button name="action_return"
                            string="Вернуть на доработку"
                            type="object"
                            class="btn-warning"
                            invisible="not button_return_enabled or state not in ['under_approval', 'approval', 'approval_medical_examination']"
                            context="{'fixed_return_state': 'draft'}"/>

                    <!-- Отклонить (under_approval, approval, approval_medical_examination) - для согласующих, кроме employee -->
                    <button name="action_reject_wizard"
                            string="Отклонить"
                            type="object"
                            class="btn-danger"
                            invisible="not button_approve_enabled or state not in ['under_approval', 'approval', 'approval_medical_examination'] or is_employee_signer"/>

                    <!-- Отменить (draft, under_approval, approval) - для инициатора -->
                    <button name="action_cancel_document"
                            string="Отменить"
                            type="object"
                            class="btn-danger"
                            invisible="not can_cancel"
                            confirm="Вы уверены, что хотите отменить документ?"/>

                    <!-- ========================================= -->
                    <!-- Кнопки скачивания отчётов                 -->
                    <!-- ========================================= -->
                    <button name="download_report_pdf"
                            string="Скачать PDF"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-pdf-o"
                            invisible="state not in ['processing', 'done', 'review'] or not has_report"/>
                    <button name="download_report_docx"
                            string="Скачать DOCX"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-word-o"
                            invisible="state not in ['processing', 'done', 'review'] or not has_report"/>

                    <!-- ========================================= -->
                    <!-- Statusbar                                 -->
                    <!-- ========================================= -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,under_approval,processing,review,done"/>
                </header>

                <sheet>
                    <!-- ========================================= -->
                    <!-- Информационные баннеры                    -->
                    <!-- ========================================= -->
                    
                    <!-- Баннер: Ожидание согласования -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'under_approval' or button_approve_enabled">
                        <strong>Ожидание согласования.</strong> Документ находится на согласовании у других пользователей.
                    </div>

                    <!-- Баннер: Требуется ваше согласование -->
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'under_approval' or not button_approve_enabled">
                        <strong>Требуется ваше согласование!</strong> Нажмите кнопку "Согласовать" для продолжения.
                    </div>

                    <!-- Баннер: Ожидание утверждения -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'approval' or button_approve_enabled">
                        <strong>Ожидание утверждения.</strong> Документ ожидает утверждения и подписания ЭЦП.
                    </div>

                    <!-- Баннер: Требуется утверждение с ЭЦП -->
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'approval' or not button_approve_enabled">
                        <strong>Требуется ваша подпись с ЭЦП!</strong> Нажмите кнопку "Утвердить с ЭЦП" для подписания документа.
                    </div>

                    <!-- Баннер: Ожидание подписания (мед. освидетельствование) -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'approval_medical_examination' or button_approve_enabled">
                        <strong>Подписание (мед. освидетельствование).</strong> Документ ожидает подписания ЭЦП участниками.
                    </div>

                    <!-- Баннер: Требуется подпись с ЭЦП (мед. освидетельствование) -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'approval_medical_examination' or not button_approve_enabled">
                        <strong>Требуется ваша подпись с ЭЦП.</strong> Нажмите кнопку "Подписать с ЭЦП" для подписания документа.
                    </div>

                    <!-- Баннер: Ожидание обработки -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'processing' or button_approve_enabled">
                        <strong>Обработка.</strong> Документ ожидает обработки ответственным сотрудником.
                    </div>

                    <!-- Баннер: Требуется обработка -->
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'processing' or not button_approve_enabled">
                        <strong>Требуется ваша обработка.</strong> Внесите данные в учётную систему и нажмите "Обработано".
                    </div>

                    <!-- Баннер: Ознакомление (для инициатора) -->
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'review' or not is_initiator">
                        <strong>Документ подписан.</strong> Ознакомьтесь с результатом, отправьте исходящее письмо и нажмите "Ознакомлен" для завершения.
                    </div>

                    <!-- Баннер: Ожидание ознакомления (для не-инициатора) -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'review' or is_initiator">
                        <strong>Ознакомление.</strong> Документ ожидает ознакомления и отправки письма инициатором.
                    </div>

                    <!-- ========================================= -->
                    <!-- Основная информация                       -->
                    <!-- ========================================= -->
                    <group>
                        <group string="Основная информация">
                            <field name="name" readonly="1"/>
                            <field name="type_id" readonly="state != 'draft'"/>
                            <field name="subject" readonly="state != 'draft'"/>
                            <field name="language" readonly="state != 'draft'"/>
                            <field name="incoming_id" readonly="state != 'draft'"/>
                            <field name="create_uid" string="Инициатор" readonly="1"/>
                            <field name="create_date" string="Дата создания" readonly="1"/>
                        </group>
                        <group string="Согласование">
                            <field name="available_signer_ids" invisible="1"/>
                            <field name="esp_signer_id"
                                    readonly="state != 'draft'"
                                    options="{'no_create': True}"
                                    domain="[('id', 'in', available_signer_ids)]"
                                    placeholder="Выберите утверждающего..."/>
                            <field name="additional_approver_ids"
                                    widget="many2many_tags"
                                    readonly="state != 'draft'"
                                    options="{'no_create': True}"
                                    placeholder="Выберите согласующих..."/>
                        </group>
                    </group>

                    <group string="Краткое содержание письма">
                        <field name="summary" colspan="2" nolabel="1"
                               readonly="state != 'draft'"/>
                    </group>


                    <!-- Скрытые поля для условий видимости -->
                    <field name="button_approve_enabled" invisible="1"/>
                    <field name="button_return_enabled" invisible="1"/>
                    <field name="user_can_approve" invisible="1"/>
                    <field name="user_esp" invisible="1"/>
                    <field name="is_initiator" invisible="1"/>
                    <field name="can_cancel" invisible="1"/>
                    <field name="is_employee_signer" invisible="1"/>
                    <field name="show_main_attachment" invisible="1"/>

                    <!-- ========================================= -->
                    <!-- Вложения                                  -->
                    <!-- ========================================= -->
                    <group>
                        <group string="Вложения">
                            <field name="attachment_to_sign_ids"
                                   widget="many2many_binary"
                                   string="Исходящее письмо для подписания"
                                   readonly="state not in ['draft']"
                                   invisible="not show_main_attachment"
                                   required="show_main_attachment"/>

                            <field name="attachment_additional_sign_ids"
                                   widget="many2many_binary"
                                   string="Дополнительные документы для подписания"
                                   readonly="state not in ['draft']"/>

                            <field name="attachment_extra_ids"
                                   widget="many2many_binary"
                                   string="Прочие документы без подписи"
                                   readonly="state not in ['draft']"/>
                        </group>
                    </group>

                    <!-- ========================================= -->
                    <!-- Notebook: Согласование                    -->
                    <!-- ========================================= -->
                    
                    <!-- Скрытое поле для видимости вкладки Информация письма -->
                    <field name="show_simple" invisible="1"/>
                    <field name="show_explanation" invisible="1"/>
                    <field name="show_medical_examination" invisible="1"/>
                    <field name="show_medical_checkup" invisible="1"/>
                    <field name="show_change_conditions" invisible="1"/>
                    <field name="show_job_offer" invisible="1"/>
                    <field name="show_reference" invisible="1"/>
                    <field name="show_guarantee" invisible="1"/>
                    <field name="show_rus_fields" invisible="1"/>
                    <field name="show_kaz_fields" invisible="1"/>
                    <field name="show_employee_fields" invisible="1"/>
                    <field name="available_medical_worker_ids" invisible="1"/>

                    
                    <notebook>
                        <!-- Вкладка: Информация письма -->
                        <page string="Информация письма" name="info_letter"
                            invisible="show_main_attachment">
                            <group> <!-- Общая информация -->
                                <field name="employee_id" invisible="not show_employee_fields" readonly="state != 'draft'"/>
                                <field name="employee_job_id" invisible="not show_employee_fields" readonly="state != 'draft'"/>
                            </group>
                            <group> <!-- медицинский осмотр -->
                                <field name="medical_checkup_date" invisible="not show_medical_checkup" readonly="state != 'draft'"/>
                                <field name="checkup_time" invisible="not show_medical_checkup" readonly="state != 'draft'"/>
                                <field name="clinic" invisible="not show_medical_checkup" readonly="state != 'draft'"/>
                                <field name="clinic_address" invisible="not show_medical_checkup" readonly="state != 'draft'"/>
                                <field name="additional_screenings" invisible="not show_medical_checkup" readonly="state != 'draft'"/>
                                <field name="reason_for_checkup_additional_screenings_kaz" invisible="not show_medical_checkup or not additional_screenings" readonly="state != 'draft'"/>
                                <field name="reason_for_checkup_additional_screenings_rus" invisible="not show_medical_checkup or not additional_screenings" readonly="state != 'draft'"/>
                            </group> 
                            <group> <!-- Объяснительная -->
                                <field name="explanatory_note_text_kaz" invisible="not show_explanation" readonly="state != 'draft'"/>
                                <field name="explanatory_note_text_rus" invisible="not show_explanation" readonly="state != 'draft'"/>
                                <field name="text_attachments_kaz" invisible="not show_explanation" readonly="state != 'draft'"/>
                                <field name="text_attachments_rus" invisible="not show_explanation" readonly="state != 'draft'"/>
                            </group>
                            <group> <!-- медицинское освидетельствование -->
                                <field name="employee_identification_id" invisible="not show_medical_examination" readonly="state != 'draft'"/>
                                <field name="employee_udo_number" invisible="not show_medical_examination" readonly="state != 'draft'"/>
                                <field name="employee_udo_issuing_authority" invisible="not show_medical_examination" readonly="state != 'draft'"/>
                                <field name="employee_udo_issuing_date" invisible="not show_medical_examination" readonly="state != 'draft'"/>
                                <field name="act_number" invisible="not show_medical_examination" readonly="state != 'draft'"/>
                                <field name="act_date" invisible="not show_medical_examination" readonly="state != 'draft'"/>
                                <field name="reason_for_medical_examination_rus" invisible="not show_medical_examination or not show_rus_fields" readonly="state != 'draft'"/>
                                <field name="reason_for_medical_examination_kaz" invisible="not show_medical_examination or not show_kaz_fields" readonly="state != 'draft'"/>
                                <field name="medical_worker_id" invisible="not show_medical_examination" readonly="state != 'draft'" domain="[('id', 'in', available_medical_worker_ids)]" options="{'no_create': True}" placeholder="Выберите портального пользователя..."/>
                                <field name="medical_assessment_refusal" invisible="not show_medical_examination or not medical_assessment_refusal" readonly="state != 'draft'"/>
                            </group>
                            <group> <!-- Предложение о работе -->
                                <field name="candidate_name" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="candidate_email" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="candidate_phone" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="job_offer_position_id" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="custom_salary_bool" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="salary" invisible="not show_job_offer or custom_salary_bool" readonly="state != 'draft'"/>
                                <field name="custom_salary" invisible="not show_job_offer or not custom_salary_bool" readonly="state != 'draft'"/>
                                <field name="time_type" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="part_time_hours" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="working_hours" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="work_start_date" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="contract_period" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="trial_period" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="holiday_days" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="additional_info_1" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="additional_info_2" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="offer_end_date" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="contact_phone" invisible="not show_job_offer" readonly="state != 'draft'"/>
                                <field name="contact_email" invisible="not show_job_offer" readonly="state != 'draft'"/>
                            </group>
                            <group> <!-- Справка с места работы -->
                                <field name="employee_identification_id" invisible="not show_reference" readonly="state != 'draft'"/>
                                <field name="employee_contract_date" invisible="not show_reference" readonly="state != 'draft'"/>
                                <field name="work_schedule_needed" invisible="not show_reference" readonly="state != 'draft'"/>
                                <field name="salary_needed" invisible="not show_reference" readonly="state != 'draft'"/>
                                <field name="vacation_start_date" invisible="not show_reference or not show_rus_fields" readonly="state != 'draft'"/>
                                <field name="vacation_end_date" invisible="not show_reference or not show_rus_fields" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <!-- Вкладка: Получатели письма -->
                        <page string="Получатели письма" name="recipients">
                            <field name="correspondent_line_ids" nolabel="1" colspan="2"
                                readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name" width="200px"/>
                                    <field name="shipment_method_ids" widget="many2many_tags" options="{'no_create': True}" width="250px"/>
                                    <field name="full_name" width="180px"/>
                                    <field name="address" width="200px"/>
                                    <field name="position" width="150px"/>
                                    <field name="email" width="180px"/>
                                    <field name="odoo_user_id" width="180px"/>
                                    <field name="phone" width="150px"/>
                                </list>
                            </field>
                        </page>

                        <!-- Вкладка: Текущие согласующие -->
                        <page string="Согласующие" name="approvers"
                              invisible="state in ['draft', 'done', 'rejected', 'canceled']">
                            <field name="state_agreement_line_ids" readonly="1">
                                <list decoration-success="status == 'agreed'"
                                      decoration-warning="status == 'in_progress'"
                                      decoration-muted="status == 'waiting'"
                                      decoration-danger="status == 'rejected'">
                                    <field name="sequence" string="№"/>
                                    <field name="user_id"/>
                                    <field name="job_id"/>
                                    <field name="status"/>
                                    <field name="need_esp" string="ЭЦП"/>
                                    <field name="agreement_date"/>
                                    <field name="commentary"/>
                                </list>
                            </field>
                        </page>

                        <!-- Вкладка: История согласований -->
                        <page string="История согласований" name="approval_history">
                            <field name="state_agreement_history_line_ids" readonly="1">
                                <list>
                                    <field name="user_id"/>
                                    <field name="job_id"/>
                                    <field name="status"/>
                                    <field name="agreement_date"/>
                                    <field name="commentary"/>
                                    <field name="signed" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>

                <!-- ========================================= -->
                <!-- Chatter                                   -->
                <!-- ========================================= -->
                <chatter/>

            </form>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- Search View                                    -->
    <!-- ============================================== -->
    <record id="view_corr_outgoing_search" model="ir.ui.view">
        <field name="name">corr.outgoing.search</field>
        <field name="model">corr.outgoing</field>
        <field name="arch" type="xml">
            <search string="Исходящая корреспонденция">
                <field name="name"/>
                <field name="subject"/>
                <field name="create_uid" string="Инициатор"/>
                <separator/>
                <filter string="Мои документы" name="my_documents" 
                        domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter string="Черновик" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Согласование" name="state_under_approval" domain="[('state', '=', 'under_approval')]"/>
                <filter string="Утверждение" name="state_approval" domain="[('state', '=', 'approval')]"/>
                <filter string="Обработка" name="state_processing" domain="[('state', '=', 'processing')]"/>
                <filter string="Ознакомление" name="state_review" domain="[('state', '=', 'review')]"/>
                <filter string="Закрыто" name="state_done" domain="[('state', '=', 'done')]"/>
                <filter string="Отклонено" name="state_rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Отменено" name="state_canceled" domain="[('state', '=', 'canceled')]"/>
                <separator/>
                <filter string="Статус" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Инициатор" name="group_initiator" context="{'group_by': 'create_uid'}"/>
                <filter string="Дата создания" name="group_date" context="{'group_by': 'create_date:month'}"/>
                <separator/>
                <filter name="activities_my" string="С моими активити"
                        domain="[('activity_user_id', '=', uid)]"/>
                <filter name="activities_overdue" string="Просроченные активити"
                        domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="activities_today" string="Активити на сегодня"
                        domain="[('my_activity_date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="activities_upcoming_all" string="Будущие активити"
                        domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

