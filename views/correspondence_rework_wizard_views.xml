<odoo>
    <record id="view_correspondence_rework_wizard_form" model="ir.ui.view">
        <field name="name">correspondence.rework.wizard.form</field>
        <field name="model">correspondence.rework.wizard</field>
        <field name="arch" type="xml">
            <form string="Отправка на доработку">
                <sheet>
                    <group>
                        <field name="incoming_id" readonly="1"/>
                        <field name="reason"/>
                    </group>

                    <group>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="user_id"/>
                                <field name="resolution_id"/>
                                <field name="deadline"/>
                                <field name="report_needed"/>
                            </tree>
                        </field>
                    </group>
                </sheet>

                <footer>
                    <button name="action_confirm"
                            string="Отправить на доработку"
                            type="object"
                            class="btn-primary"/>
                    <button string="Отмена" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
