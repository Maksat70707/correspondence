<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================== -->
        <!-- Основной approval для исходящей корреспонденции -->
        <!-- ============================================== -->
        <record id="corr_outgoing_approval" model="appstream.approval">
            <field name="model_id" ref="model_corr_outgoing"/>
            <field name="name">Исходящая корреспонденция</field>
        </record>

        <!-- ============================================== -->
        <!-- Статусы ДО согласования (before)               -->
        <!-- ============================================== -->

        <record id="corr_outgoing_state_draft" model="appstream.approval.state">
            <field name="approval_id" ref="corr_outgoing_approval"/>
            <field name="name">Черновик</field>
            <field name="type">before</field>
            <field name="sequence">0</field>
            <field name="state">draft</field>
        </record>

        <!-- ============================================== -->
        <!-- Статусы ПОСЛЕ согласования (after)             -->
        <!-- ============================================== -->

        <record id="corr_outgoing_state_done" model="appstream.approval.state">
            <field name="approval_id" ref="corr_outgoing_approval"/>
            <field name="name">Закрыто</field>
            <field name="type">after</field>
            <field name="sequence">100</field>
            <field name="state">done</field>
        </record>

        <record id="corr_outgoing_state_rejected" model="appstream.approval.state">
            <field name="approval_id" ref="corr_outgoing_approval"/>
            <field name="name">Отклонено</field>
            <field name="type">after</field>
            <field name="sequence">101</field>
            <field name="state">rejected</field>
            <field name="reject_state">True</field>
        </record>

        <record id="corr_outgoing_state_canceled" model="appstream.approval.state">
            <field name="approval_id" ref="corr_outgoing_approval"/>
            <field name="name">Отменено</field>
            <field name="type">after</field>
            <field name="sequence">102</field>
            <field name="state">canceled</field>
        </record>

        <!-- ============================================== -->
        <!-- Workflow (этапы согласования)                  -->
        <!-- ============================================== -->

        <!--
            Стандартный тип:
                under_approval → approval → processing → review → done

            medical_examination:
                under_approval → approval_medical_examination → processing → review → done
        -->

        <!-- Согласование (seq 10) — руководитель + дополнительные -->
        <record id="corr_outgoing_workflow_under_approval" model="appstream.approval.workflow">
            <field name="approval_id" ref="corr_outgoing_approval"/>
            <field name="name">Согласование</field>
            <field name="state">under_approval</field>
            <field name="sequence">10</field>
            <field name="condition">True</field>
            <field name="allow_return">True</field>
            <field name="allow_cancel">False</field>
            <field name="schedule_activity">True</field>
            <field name="before_script">record.get_agreement_lines('under_approval')</field>
            <field name="after_script">record.after_script('approval_medical_examination' if record._is_medical_examination_type() else 'approval', 'under_approval')</field>
            <field name="approve_button_name">Согласовать</field>
            <field name="approve_confirm_msg">Подтвердить согласование?</field>
            <field name="reject_button_name">Отклонить</field>
            <field name="reject_button_wizard">True</field>
        </record>

        <!-- Утверждение (seq 20) — стандартные типы, esp_signer_id с ЭЦП -->
        <record id="corr_outgoing_workflow_approval" model="appstream.approval.workflow">
            <field name="approval_id" ref="corr_outgoing_approval"/>
            <field name="name">Утверждение</field>
            <field name="state">approval</field>
            <field name="sequence">20</field>
            <field name="condition">not record._is_medical_examination_type()</field>
            <field name="need_esp">True</field>
            <field name="allow_return">True</field>
            <field name="allow_cancel">False</field>
            <field name="schedule_activity">True</field>
            <field name="before_script">record.get_agreement_lines('approval')</field>
            <field name="after_script">record.after_script('processing', 'approval')</field>
            <field name="approve_button_name">Утвердить с ЭЦП</field>
            <field name="approve_confirm_msg">Подписать документ с ЭЦП?</field>
            <field name="reject_button_name">Отклонить</field>
            <field name="reject_button_wizard">True</field>
        </record>

        <!--
            Утверждение medical_examination (seq 21)
            3 подписанта с ЭЦП последовательно:
                1. employee_id      (в системе)
                2. esp_signer_id    (в системе)
                3. medical_worker   (на портале)
        -->
        <record id="corr_outgoing_workflow_approval_medical_examination" model="appstream.approval.workflow">
            <field name="approval_id" ref="corr_outgoing_approval"/>
            <field name="name">Утверждение (мед. освидетельствование)</field>
            <field name="state">approval_medical_examination</field>
            <field name="sequence">21</field>
            <field name="condition">record._is_medical_examination_type()</field>
            <field name="need_esp">True</field>
            <field name="allow_return">True</field>
            <field name="allow_cancel">False</field>
            <field name="schedule_activity">True</field>
            <field name="before_script">record.get_agreement_lines('approval_medical_examination')</field>
            <field name="after_script">record.after_script('processing', 'approval_medical_examination')</field>
            <field name="approve_button_name">Подписать с ЭЦП</field>
            <field name="approve_confirm_msg">Подписать документ с ЭЦП?</field>
            <field name="reject_button_name">Отклонить</field>
            <field name="reject_button_wizard">True</field>
        </record>

        <!-- Обработка (seq 30) — секретарь -->
        <record id="corr_outgoing_workflow_processing" model="appstream.approval.workflow">
            <field name="approval_id" ref="corr_outgoing_approval"/>
            <field name="name">Обработка</field>
            <field name="state">processing</field>
            <field name="sequence">30</field>
            <field name="condition">True</field>
            <field name="allow_return">False</field>
            <field name="allow_cancel">False</field>
            <field name="schedule_activity">True</field>
            <field name="after_script">record.after_script('review', 'processing')</field>
            <field name="approve_button_name">Обработано</field>
            <field name="approve_confirm_msg">Подтвердить обработку?</field>
        </record>

        <!-- Ознакомление (seq 40) — инициатор -->
        <record id="corr_outgoing_workflow_review" model="appstream.approval.workflow">
            <field name="approval_id" ref="corr_outgoing_approval"/>
            <field name="name">Ознакомление</field>
            <field name="state">review</field>
            <field name="sequence">40</field>
            <field name="condition">True</field>
            <field name="allow_return">False</field>
            <field name="allow_cancel">False</field>
            <field name="schedule_activity">True</field>
            <field name="after_script">record.after_script('done', 'review')</field>
            <field name="approve_button_name">Ознакомлен</field>
            <field name="approve_confirm_msg">Подтвердить ознакомление?</field>
        </record>

    </data>

</odoo>
